msgstr "Склоп датотека ФАТ32"

#. Type: text
#. Description
#. :sl1:
#. Short file system name (untranslatable in many languages)
#: ../partman-basicfilesystems.templates:35001
msgid "fat32"
msgstr "fat32"

#. Type: text
#. Description
#. :sl2:
#: ../partman-basicfilesystems.templates:36001
#, fuzzy
msgid "NTFS journaling file system"
